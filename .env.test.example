# Default test and PostgreSQL integration settings
APP_NAME=Home AI Hub API Test
APP_VERSION=0.1.0
APP_ENVIRONMENT=test
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=WARNING

# Optional local PostgreSQL 17 integration service
POSTGRES_USER=home_ai_hub_test
POSTGRES_PASSWORD=replace_with_test_password
POSTGRES_DB=home_ai_hub_test_admin
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://home_ai_hub_test:replace_with_test_password@127.0.0.1:5433/home_ai_hub_test_admin
SQLALCHEMY_ECHO=false
POOL_SIZE=2
MAX_OVERFLOW=0
DATABASE_HEALTHCHECK_TIMEOUT_SECONDS=3

# Default pytest remains deterministic and offline
LLM_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-default
LLM_TIMEOUT_SECONDS=5
LLM_CONNECT_TIMEOUT_SECONDS=
LLM_READ_TIMEOUT_SECONDS=
LLM_STREAM_TIMEOUT_SECONDS=
LLM_DEFAULT_TEMPERATURE=0.0
LLM_DEFAULT_MAX_TOKENS=128

# Real-provider integration values must be injected explicitly when authorized.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_DEFAULT_MODEL=

# This template never opts into billable tests.
LLM_INTEGRATION_ACKNOWLEDGE_COST=false
