# Local development application settings
APP_NAME=Home AI Hub
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Local PostgreSQL reached from the host process
DATABASE_URL=postgresql+asyncpg://home_ai_hub:replace_with_local_password@127.0.0.1:5432/home_ai_hub
SQLALCHEMY_ECHO=false
POOL_SIZE=5
MAX_OVERFLOW=10
DATABASE_HEALTHCHECK_TIMEOUT_SECONDS=3

# Offline LLM defaults
LLM_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-default
LLM_TIMEOUT_SECONDS=30
# Leave blank to inherit LLM_TIMEOUT_SECONDS
LLM_CONNECT_TIMEOUT_SECONDS=
LLM_READ_TIMEOUT_SECONDS=
# Maximum idle time between streaming events, not total stream duration
LLM_STREAM_TIMEOUT_SECONDS=
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=1024

# API keys and models remain empty. Base URLs are non-secret endpoint configuration.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=

# Real LLM tests still require the explicit pytest CLI switch.
LLM_INTEGRATION_ACKNOWLEDGE_COST=false
