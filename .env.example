APP_NAME=Home AI Hub API
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# PostgreSQL container
POSTGRES_USER=home_ai_hub
POSTGRES_PASSWORD=change_me
POSTGRES_DB=home_ai_hub
POSTGRES_PORT=5432

# SQLAlchemy runtime
DATABASE_URL=postgresql+asyncpg://home_ai_hub:change_me@127.0.0.1:5432/home_ai_hub
DOCKER_DATABASE_URL=postgresql+asyncpg://home_ai_hub:change_me@postgres:5432/home_ai_hub
SQLALCHEMY_ECHO=false
POOL_SIZE=5
MAX_OVERFLOW=10
DATABASE_HEALTHCHECK_TIMEOUT_SECONDS=3

# LLM provider layer; mock remains zero-key and fully offline
LLM_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-model
LLM_TIMEOUT_SECONDS=30
# Leave blank to inherit LLM_TIMEOUT_SECONDS
LLM_CONNECT_TIMEOUT_SECONDS=
LLM_READ_TIMEOUT_SECONDS=
# Maximum idle time between streaming events, not a total stream duration
LLM_STREAM_TIMEOUT_SECONDS=
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=1024

# Required only when LLM_PROVIDER=openai; base URL must be supplied as HTTPS
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=

# Required only when LLM_PROVIDER=deepseek; base URL must be supplied as HTTPS
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_DEFAULT_MODEL=

# Test-process safety gate only; keep false for normal development and CI.
# Real LLM tests also require the explicit --run-llm-integration CLI switch.
LLM_INTEGRATION_ACKNOWLEDGE_COST=false

# Redis container only; no application integration in this phase
REDIS_PORT=6379
