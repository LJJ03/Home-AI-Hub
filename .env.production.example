# Production deployment contract. Copying this file unchanged must fail closed.
APP_NAME=Home AI Hub
APP_VERSION=0.1.0
APP_ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Required: inject the complete secret URL through the deployment platform.
DATABASE_URL=
SQLALCHEMY_ECHO=false
POOL_SIZE=10
MAX_OVERFLOW=20
DATABASE_HEALTHCHECK_TIMEOUT_SECONDS=3

# Safe production sample default; select a real provider explicitly when authorized.
LLM_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-default
LLM_TIMEOUT_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=
LLM_READ_TIMEOUT_SECONDS=
LLM_STREAM_TIMEOUT_SECONDS=
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=1024

# Required only for the selected real provider; inject through a secret manager.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_DEFAULT_MODEL=
