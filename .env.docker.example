# Docker development application settings
APP_NAME=Home AI Hub
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Local-only PostgreSQL container bootstrap values
POSTGRES_USER=home_ai_hub
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=home_ai_hub
POSTGRES_PORT=5432

# Backend reaches PostgreSQL by its Compose service name
DATABASE_URL=postgresql+asyncpg://home_ai_hub:replace_with_local_password@postgres:5432/home_ai_hub
DOCKER_DATABASE_URL=postgresql+asyncpg://home_ai_hub:replace_with_local_password@postgres:5432/home_ai_hub
SQLALCHEMY_ECHO=false
POOL_SIZE=5
MAX_OVERFLOW=10
DATABASE_HEALTHCHECK_TIMEOUT_SECONDS=3

# Offline LLM defaults
LLM_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-default
LLM_TIMEOUT_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=
LLM_READ_TIMEOUT_SECONDS=
LLM_STREAM_TIMEOUT_SECONDS=
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=1024

# Unselected providers remain empty. Never store real keys in this file.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_DEFAULT_MODEL=

# Redis is started by Compose but is not an application dependency.
REDIS_PORT=6379
